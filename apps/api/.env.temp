DJANGO_ENV=dev
SECRET_KEY=dev
ALLOWED_HOSTS="urbankiff.local,panel.urbankiff.local,api.urbankiff.local,api"
WEB_URL=http://urbankiff.local

SMTP_USERNAME=
SMTP_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
API_FOLDER=${APP_FOLDER}/api
API_CONTAINER_NAME=api
API_DOMAIN_NAME=api.urbankiff.local
API_URL=http://api.urbankiff.local
DB_HOST="postgresDB"
