DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgresDB
MINIO_ROOT_USER=urbankiff
MINIO_ROOT_PASSWORD=urbankiff_pass
