# Local development — mount the source with a volume, node_modules are isolated
FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat

EXPOSE 3000

# Dependencies are installed at container start so the volume-mounted source
# doesn't overwrite node_modules (see docker-compose nextjs_node_modules volume)
CMD ["sh", "-c", "yarn install && yarn dev --hostname 0.0.0.0 --port 3000 --turbopack"]
