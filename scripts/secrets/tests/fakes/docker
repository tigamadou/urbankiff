#!/usr/bin/env bash
# Faux docker pour les tests : journalise les arguments et renvoie une valeur de la longueur demandée (« head -c N »).
set -euo pipefail
: "${FAKE_DOCKER_LOG:?}"
echo "ARGS $*" >> "$FAKE_DOCKER_LOG"
n="$(printf '%s' "${!#}" | sed -nE 's/.*head -c ([0-9]+).*/\1/p')"
printf '%*s' "$n" '' | tr ' ' 'x'
