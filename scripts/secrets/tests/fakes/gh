#!/usr/bin/env bash
# Faux gh pour les tests : journalise les arguments et la longueur de l'entrée standard, jamais son contenu.
set -euo pipefail
: "${FAKE_GH_LOG:?}" "${FAKE_GH_ETAT:?}"
echo "ARGS $*" >> "$FAKE_GH_LOG"
case "$1 $2" in
  "secret set"|"variable set")
    nom="$3"
    if [ "$2" = "set" ] && [ "$1" = "secret" ]; then
      contenu="$(cat)"
      echo "STDIN $nom ${#contenu}" >> "$FAKE_GH_LOG"
    fi
    echo "$1 $nom" >> "$FAKE_GH_ETAT"
    ;;
  "secret list"|"variable list")
    { grep "^$1 " "$FAKE_GH_ETAT" 2>/dev/null || true; } | cut -d' ' -f2
    ;;
  *) echo "faux gh : commande inattendue : $*" >&2; exit 1 ;;
esac
