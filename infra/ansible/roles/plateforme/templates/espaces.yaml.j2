apiVersion: v1
kind: Namespace
metadata:
  name: plateforme
{% for env in deploiement_envs.values() %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ env.namespace }}
---
apiVersion: v1
kind: LimitRange
metadata:
  name: defauts
  namespace: {{ env.namespace }}
spec:
  limits:
    - type: Container
      default:
        memory: {{ plateforme_limitrange_memoire_defaut }}
      defaultRequest:
        memory: {{ plateforme_limitrange_memoire_requete }}
{% endfor %}
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: memoire
  namespace: {{ deploiement_envs.preprod.namespace }}
spec:
  hard:
    limits.memory: {{ preprod_quota_memoire_limites }}
    requests.memory: {{ preprod_quota_memoire_requetes }}
