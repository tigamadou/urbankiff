apiVersion: v1
kind: Config
clusters:
  - name: urbankiff
    cluster:
      server: https://127.0.0.1:6443
      certificate-authority-data: {{ deploiement_ca }}
users:
  - name: deploy
    user:
      token: {{ deploiement_jeton }}
contexts:
  - name: {{ deploiement_env }}
    context:
      cluster: urbankiff
      user: deploy
      namespace: {{ deploiement_namespace }}
current-context: {{ deploiement_env }}
