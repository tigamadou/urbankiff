# Géré par Ansible. Aucun secret ici.
URBANKIFF_ENV={{ item.key }}
GHCR_OWNER={{ ghcr_owner }}
NAMESPACE={{ item.value.namespace }}
API_SERVER_CIDR={{ item.value.api_server_ip | default(ansible_default_ipv4.address) }}/32
{% if item.key == 'prod' %}
# Bucket Wasabi de la preprod : cible de l'export anonymisé (action exporter-anonyme, prod seulement). Aucun secret.
BUCKET_COPIE_PREPROD={{ bucket_copie_preprod }}
{% endif %}
