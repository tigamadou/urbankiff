#!/usr/bin/env bash
# Faux ssh : journalise les arguments, la longueur et les noms de l'entrée standard, jamais son contenu.
set -euo pipefail
: "${FAKE_LOG:?}"
echo "ssh $*" >> "$FAKE_LOG"
contenu="$(cat; printf x)"; contenu="${contenu%x}"
echo "STDIN ssh ${#contenu}" >> "$FAKE_LOG"
printf '%s' "$contenu" | sed -nE 's/^([A-Za-z0-9_]+)=.*/\1/p' | tr '\n' ',' | sed 's/^/STDIN_NOMS /' >> "$FAKE_LOG"
echo >> "$FAKE_LOG"
