#!/usr/bin/env bash
# Faux helm : journalise les arguments ; `pull --untar` crée le chart décompressé ; `get values` et `template` rendent
# des fichiers de $FAKE_STATE.
set -euo pipefail
: "${FAKE_LOG:?}"
echo "helm $*" >> "$FAKE_LOG"
case "$1" in
  pull)
    [ -z "${FAKE_PULL_ECHEC:-}" ] || { echo "not found" >&2; exit 1; }
    nom="${2##*/}"
    dest=""
    for ((i = 1; i <= $#; i++)); do [ "${!i}" = "--untardir" ] && { j=$((i + 1)); dest="${!j}"; }; done
    mkdir -p "$dest/$nom"
    : > "$dest/$nom/values-preprod.yaml"; : > "$dest/$nom/values-prod.yaml"
    ;;
  upgrade) [ -z "${FAKE_UPGRADE_ECHEC:-}" ] || { echo "echec" >&2; exit 1; } ;;
  get)
    [ "$2" = values ] || exit 1
    [ -f "${FAKE_STATE:?}/values-$3.yaml" ] || { echo "release introuvable" >&2; exit 1; }
    cat "$FAKE_STATE/values-$3.yaml" ;;
  template)
    [ -z "${FAKE_TEMPLATE_ECHEC:-}" ] || { echo "echec de rendu" >&2; exit 1; }
    gabarit=""
    for ((i = 1; i <= $#; i++)); do [ "${!i}" = "--show-only" ] && { j=$((i + 1)); gabarit="$(basename "${!j}")"; }; done
    if [ -f "${FAKE_STATE:?}/rendu-$gabarit" ]; then cat "$FAKE_STATE/rendu-$gabarit"; else echo "kind: Job"; fi ;;
esac
