#!/usr/bin/env bash
# Faux curl : échoue FAKE_CURL_ECHECS fois (ou toujours si -1) puis réussit ; échoue aussi si FAKE_CURL_ECHEC_SUR est
# contenu dans les arguments. Avec `-K -`, journalise seulement la longueur de l'entrée standard.
set -euo pipefail
: "${FAKE_LOG:?}" "${FAKE_STATE:?}"
echo "curl $*" >> "$FAKE_LOG"
if [[ " $* " == *" -K - "* ]]; then
  contenu="$(cat; printf x)"; contenu="${contenu%x}"
  echo "STDIN curl ${#contenu}" >> "$FAKE_LOG"
fi
if [ -n "${FAKE_CURL_ECHEC_SUR:-}" ] && [[ "$*" == *"$FAKE_CURL_ECHEC_SUR"* ]]; then
  # Avec -w '%{http_code}' (sans -f) : curl sort 0 et affiche le code HTTP, FAKE_CURL_CODE (000 = échec réseau).
  if [[ " $* " == *" -w "* ]]; then printf '%s' "${FAKE_CURL_CODE:-404}"; [ "${FAKE_CURL_CODE:-404}" != 000 ] || exit 7; exit 0; fi
  exit 22
fi
n="$(cat "$FAKE_STATE/curl.n" 2>/dev/null || echo 0)"
echo $((n + 1)) > "$FAKE_STATE/curl.n"
echecs="${FAKE_CURL_ECHECS:-0}"
[ "$echecs" -ge 0 ] && [ "$n" -ge "$echecs" ] || exit 22
[[ " $* " != *" -w "* ]] || printf 200
